<% layout("/layouts/boilerplate.ejs") %>
<body>
    <div class="row">
        <div class="col offset-2">

    
    <h2>Edit  Listing</h2>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" >
       <div class="mb-3"> <input name="listing[title]" value="<%=listing.title%>" type="text"/ class="form-control"></div>
     <div class="mb-3">     <input name="listing[description]" value="<%=listing.description%>" type="text" class="form-control"/ ></div>
    
     <div class="mb-3">  <input name="listing[image]"value="<%=listing.image%>" type="text" class=form-control/></div>
           <div class="mb-3">  <input name="listing[price]" value="<%=listing.price%>" type="number" class="form-control"/></div>
        
          
      <div class="mb-3"> <input name="listing[country]" value="<%=listing.country%>" type="text" class="form-control"/ ></div>
           
 
        <button class="mb-5">Edit</button>
    </form>
        </div>
    </div>
    
</body>
